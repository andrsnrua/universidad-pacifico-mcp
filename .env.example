# Se pasan al proceso MCP mediante el cliente o el shell.
# El servidor no carga archivos .env automáticamente.
# Las rutas deben ser absolutas; usa directorios privados de tu cuenta.
# UP_MCP_SESSION_DIR=/ruta/privada/up-mcp-session
# UP_MCP_DOWNLOAD_DIR=/ruta/privada/materiales-up
# UP_MCP_MAX_FILE_BYTES=104857600
# UP_MCP_MAX_TOTAL_BYTES=524288000
# Activar únicamente en un equipo personal de confianza.
UP_MCP_REMEMBER_SSO=0
# En macOS/Linux, recordar SSO requiere además una clave privada >= 16 caracteres.
# UP_MCP_SECRET_KEY=
